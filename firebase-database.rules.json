{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      ".read": "auth != null && auth.token.email === 'dendiking56@gmail.com'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "sessionId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "status": {
          ".validate": "newData.val() === 'online' || newData.val() === 'offline'"
        },
        "flowPage": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "flowStep": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
        },
        "startedAt": {
          ".validate": "newData.isNumber()"
        },
        "lastAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "access": {
      ".read": "auth != null && auth.token.email === 'dendiking56@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'dendiking56@gmail.com')",
        ".write": "auth != null && auth.token.email === 'dendiking56@gmail.com'",
        "blocked": {
          ".validate": "newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "commands": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.token.email === 'dendiking56@gmail.com'",
        "id": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "targetPage": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._-]+\\.html$/) && newData.val().length <= 120"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "chats": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'dendiking56@gmail.com')",
        "$messageId": {
          ".write": "auth != null && ((auth.uid === $uid && newData.child('author').val() === 'user') || (auth.token.email === 'dendiking56@gmail.com' && newData.child('author').val() === 'admin'))",
          "id": {
            ".validate": "newData.isString() && newData.val() === $messageId && newData.val().length > 0 && newData.val().length <= 120"
          },
          "sessionId": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "author": {
            ".validate": "newData.val() === 'user' || newData.val() === 'admin'"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "chatMeta": {
      ".read": "auth != null && auth.token.email === 'dendiking56@gmail.com'",
      "$uid": {
        "sessionId": {
          ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'dendiking56@gmail.com')",
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "lastMessageAt": {
          ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'dendiking56@gmail.com')",
          ".validate": "newData.isNumber()"
        },
        "adminUnread": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'dendiking56@gmail.com')",
          ".write": "auth != null && ((auth.uid === $uid && newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1) && newData.val() <= 999) || (auth.token.email === 'dendiking56@gmail.com' && newData.isNumber() && newData.val() >= 0 && newData.val() <= 999))"
        },
        "adminReadAt": {
          ".write": "auth != null && auth.token.email === 'dendiking56@gmail.com'",
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
